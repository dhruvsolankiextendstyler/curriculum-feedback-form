# Copy to .env and fill in from your Supabase project settings (API section).
# Only VITE_-prefixed vars are exposed to the browser — never put secrets here.

# Project URL — must be the API URL (https://<ref>.supabase.co), NOT the
# dashboard URL (https://supabase.com/dashboard/project/<ref>). Pasting the
# dashboard URL is the most common setup mistake; the app detects it and says so.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never prefix this with VITE_.
#
# The service_role key bypasses every RLS policy. It is read only by the
# serverless function api/admin/invite-users.js, which needs it to create auth
# accounts (FR-23, FR-24). Prefixing it with VITE_ would ship it to every
# visitor's browser and hand them full database access.
#
# Only needed to send invitations. Set it in Vercel → Project Settings →
# Environment Variables for production, and run `vercel dev` (not `npm run dev`)
# to use invites locally.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: the public origin used to build invite/reset links. Falls back to the
# request origin when unset.
# PUBLIC_SITE_URL=https://your-app.vercel.app
