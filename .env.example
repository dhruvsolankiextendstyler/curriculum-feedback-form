# Copy to .env and fill in from your Supabase project settings (API section).
# Only VITE_-prefixed vars are exposed to the browser — never put secrets here.

# Project URL — must be the API URL (https://<ref>.supabase.co), NOT the
# dashboard URL (https://supabase.com/dashboard/project/<ref>). Pasting the
# dashboard URL is the most common setup mistake; the app detects it and says so.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# These two are the ONLY variables this app needs. The anon key is safe to ship:
# it grants nothing by itself, because every table is gated by RLS.
#
# The service_role key is deliberately absent. It bypasses every RLS policy, and
# inviting users is the one action that needs it — so that runs inside a Supabase
# Edge Function (supabase/functions/invite-users), where Supabase injects the key
# from its own environment. It never travels through this file, the bundle, or a
# third-party host's dashboard.
#
# The function reads one optional setting, stored as a Supabase secret rather
# than an env var here, so invitation emails link to the deployed site:
#
#   supabase secrets set PUBLIC_SITE_URL=https://your-worker.workers.dev
#
# See README §6.
# ---------------------------------------------------------------------------
