{"nodes": [{"id": "prd_curriculum_feedback_platform", "label": "Curriculum Feedback & Analysis Platform (PRD)", "file_type": "document", "source_file": "prd.md", "source_location": "sec 1 Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static forms (Google Forms) gave the college no central user management, no role-based routing and no built-in analysis, so admins could not edit questions, control respondents, or turn responses into insight."}, {"id": "prd_user_panel", "label": "User Panel (Respondents)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 5.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_admin_panel", "label": "Admin Panel (users, questions, analytics)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 5.3-5.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_rbac", "label": "Role-Based Access Control (FR-5)", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 5.1 FR-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_role_based_routing", "label": "Role-Based Form Routing (FR-7)", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 5.2 FR-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each stakeholder type answers a different question set, so the user is sent to the form matching their assigned type instead of choosing one."}, {"id": "prd_academic_peers_form", "label": "Academic Peers Feedback Form", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 8.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_students_form", "label": "Students Feedback Form", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 8.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_employers_form", "label": "Employers & Industry Experts Feedback Form", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 8.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_alumni_form", "label": "Alumni Feedback Form", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 8.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_faculty_form", "label": "Faculty Feedback Form (4-point scale)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 8.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_likert_scales", "label": "Per-Form Likert Rating Scales", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scales differ per source form and are preserved as given rather than unified, because rewriting them would misrepresent the college's existing instruments; duplicated rating blocks are treated as copy-paste artifacts and used once."}, {"id": "prd_question_versioning", "label": "Question Versioning on Edit (FR-31)", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 4, FR-31, sec 9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editing text/type/scale/options inserts a new immutable version instead of mutating the row, so past responses stay bound to the exact wording answered and averages plus year-over-year comparisons stay accurate. Cosmetic changes (is_required, order) update in place to avoid version churn."}, {"id": "prd_soft_delete_questions", "label": "Question Soft Delete (FR-32)", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-32, sec 9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "is_active = false removes a question from the live form while its historical answers remain available to analytics and exports; a hard delete would silently destroy past data."}, {"id": "prd_question_key", "label": "Stable question_key Across Versions", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-31, sec 9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives every version of a question one grouping key so trends can follow it across rewordings."}, {"id": "prd_one_submission_per_course_per_cycle", "label": "One Submission per User per Course per Cycle (FR-15)", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 4, FR-15, sec 9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps data dedupe-free while staying forgiving: a repeat visit upserts on the unique key and opens the existing response for editing rather than inserting a duplicate."}, {"id": "prd_edit_window", "label": "Editable-Until-Cycle-Close Window (FR-16)", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-16, sec 9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes are allowed only while now() < academic_cycles.closes_at, enforced in an RLS policy rather than the UI so a stale browser tab cannot post after the cycle closes."}, {"id": "prd_academic_cycles", "label": "Academic-Year Feedback Cycles", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 4, sec 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organising feedback per academic year matches forms that already ask for the year and enables year-over-year comparison."}, {"id": "prd_csv_bulk_import", "label": "CSV Bulk User Import (FR-23)", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-23, sec 7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promoted from optional to required by the 100-500 user scale decision; import previews rows, validates, reports per-row errors and skips duplicates."}, {"id": "prd_temporary_password_provisioning", "label": "Temporary Password on Account Creation (FR-24)", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-24, FR-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accounts are created directly with a unique temporary password that must be replaced at first sign-in; invite status is deliberately not stored."}, {"id": "prd_custom_smtp", "label": "Custom Free SMTP Provider for Supabase Auth", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supabase's built-in sender is rate-limited to a few messages per hour, far too slow for hundreds of users; a free third-party provider (Brevo/Resend) is wired in as custom SMTP and kept swappable via config so switching providers needs no code change."}, {"id": "prd_zero_budget", "label": "Zero-Budget Free-Tier Constraint", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every stack and analytics choice is bounded by a zero rupee budget, which is why sentiment is lexicon-based and hosting/DB stay on free tiers."}, {"id": "prd_rls_security", "label": "Row-Level Security Enforcement (NFR-3)", "file_type": "rationale", "source_file": "prd.md", "source_location": "NFR-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integrity rules (one-per-course, edit window) live in the database/RLS layer, not only client-side, so a direct API call cannot bypass them."}, {"id": "prd_privacy_export_limits", "label": "Privacy: Exports Limited to Admins (NFR-4)", "file_type": "rationale", "source_file": "prd.md", "source_location": "NFR-4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_analytics_dashboard", "label": "Analytics & Reports Dashboard (FR-35 to FR-42)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 5.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_sentiment_analysis", "label": "Rule-Based Lexicon Sentiment Analysis (FR-40)", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-40, sec 7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "True AI sentiment would require a paid API, so v1 uses free lexicon/rule-based scoring; LLM analysis is an explicit stretch goal, not committed."}, {"id": "prd_auto_insights", "label": "Auto-Generated Rule-Based Insights (FR-41)", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyword-frequency and ranking rules produce statements like lowest-rated aspect or most requested addition without any model cost."}, {"id": "prd_csv_export", "label": "CSV Export of Raw Responses (FR-42)", "file_type": "concept", "source_file": "prd.md", "source_location": "FR-42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Export carries question version metadata so historical rewording stays visible in the data."}, {"id": "prd_pdf_report_export", "label": "PDF Summary Report per Academic Year (FR-43)", "file_type": "concept", "source_file": "prd.md", "source_location": "FR-43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly nice-to-have and named as one of the first items to defer if Week 3 slips."}, {"id": "prd_version_aware_analytics", "label": "Version-Aware Analytics and Trend Grouping (FR-34/FR-39)", "file_type": "rationale", "source_file": "prd.md", "source_location": "FR-34, FR-39, sec 9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analytics group by question_key and surface a version count so a mixed average spanning reworded variants is never presented as one consistent question."}, {"id": "prd_year_over_year_comparison", "label": "Year-over-Year Comparison (FR-39)", "file_type": "concept", "source_file": "prd.md", "source_location": "FR-39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_react_frontend", "label": "React SPA Frontend", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_supabase_backend", "label": "Supabase Backend (Postgres, Auth, RLS, Edge Functions)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_cloudflare_workers_hosting", "label": "Cloudflare Workers Static Assets Hosting", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over Vercel because Vercel's Hobby tier refuses deploys authored by anyone but the account owner, blocking a 4-person team; Cloudflare Pages was the original plan but is closed to new projects, so Workers static assets is the supported replacement."}, {"id": "prd_invite_users_edge_function", "label": "invite-users Edge Function (service_role stays server-side)", "file_type": "code", "source_file": "prd.md", "source_location": "sec 7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_high_level_architecture", "label": "High-Level Architecture (SPA to Supabase)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_open_question_course_catalog", "label": "Static Program Lists vs Admin-Managed Course Catalog (A5 / Open Question 1)", "file_type": "rationale", "source_file": "prd.md", "source_location": "sec 11 A5, OQ1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Course identity for the uniqueness constraint is the entered course_title, so free-text entry with inconsistent spellings weakens the one-per-course rule - the main argument for replacing static dropdowns with a managed catalog."}, {"id": "prd_data_model", "label": "Data Model (Supabase/Postgres tables)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_users_table", "label": "users table (role, status, must_change_password)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_academic_cycles_table", "label": "academic_cycles table (opens_at, closes_at)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_forms_table", "label": "forms table (one per stakeholder type)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_questions_table", "label": "questions table (question_key, current_version_id)", "file_type": "concept", "source_file": "prd.md", "source_location": "sec 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "prd_question_versions_table", "label": "question_versions table (immutable 