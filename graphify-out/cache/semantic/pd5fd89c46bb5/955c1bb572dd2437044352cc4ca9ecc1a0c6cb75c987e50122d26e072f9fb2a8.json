{"nodes": [{"id": "readme_curriculum_feedback_platform", "label": "Curriculum Feedback Platform README", "file_type": "document", "source_file": "README.md", "source_location": "top", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_migration_0001_schema", "label": "0001_schema.sql migration", "file_type": "code", "source_file": "README.md", "source_location": "Setup step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_migration_0002_rls", "label": "0002_rls.sql migration (RLS policies, edit-window gate, privilege guards)", "file_type": "code", "source_file": "README.md", "source_location": "Setup step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_migration_0003_seed", "label": "0003_seed.sql migration (5 forms, 4 scales, all questions, first cycle)", "file_type": "code", "source_file": "README.md", "source_location": "Setup step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_migration_0004_auth_sync", "label": "0004_auth_sync.sql migration (auth.users to profiles)", "file_type": "code", "source_file": "README.md", "source_location": "Setup step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_migration_0005_analytics", "label": "0005_analytics.sql migration (admin-only aggregate functions)", "file_type": "code", "source_file": "README.md", "source_location": "Setup step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_migration_0006_direct_users", "label": "0006_direct_users.sql migration (direct accounts, temp-password gate, soft removal)", "file_type": "code", "source_file": "README.md", "source_location": "Setup step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_profiles_table", "label": "public.profiles table (id, email, full_name, role, status)", "file_type": "concept", "source_file": "README.md", "source_location": "Setup step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_invite_users_function", "label": "supabase/functions/invite-users Edge Function", "file_type": "code", "source_file": "README.md", "source_location": "Setup step 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on Supabase rather than locally so account creation works even from npm run dev; it creates confirmed accounts directly and returns a temporary password instead of emailing an invite."}, {"id": "readme_service_role_key_isolation", "label": "service_role key never reaches the browser", "file_type": "rationale", "source_file": "README.md", "source_location": "Setup steps 2 and 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service_role key bypasses every RLS policy, and Vite inlines any VITE_ variable into the shipped bundle, so the key lives only inside the Edge Function where Supabase injects it from its own environment - there is no key to copy anywhere."}, {"id": "readme_one_per_course_unique_index", "label": "Unique index on responses (user_id, cycle_id, course_key)", "file_type": "rationale", "source_file": "README.md", "source_location": "How the locked decisions are enforced", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Makes duplicates impossible at the storage layer; the app upserts on the index so a repeat visit edits the existing row."}, {"id": "readme_course_key_generated_column", "label": "course_key generated column (lowercase, collapsed whitespace)", "file_type": "rationale", "source_file": "README.md", "source_location": "How the locked decisions are enforced", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalising the course title makes 'Linear Algebra' and 'linear  algebra' collide rather than both counting, which is the direct answer to the free-text course-identity risk raised in PRD A5."}, {"id": "readme_edit_window_rls_gate", "label": "Edit window checked inside the RLS policy", "file_type": "rationale", "source_file": "README.md", "source_location": "How the locked decisions are enforced", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes are permitted only while now() < cycle.closes_at, checked in the policy itself so a stale browser tab or a direct API call cannot post after close."}, {"id": "readme_question_version_immutability_trigger", "label": "Trigger blocking edits to an answered question version", "file_type": "rationale", "source_file": "README.md", "source_location": "How the locked decisions are enforced", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "answers reference a question_versions row, never a questions row, and the trigger raises an exception on any attempt to modify a version that already has answers, so history cannot be rewritten even by mistake."}, {"id": "readme_soft_delete_questions", "label": "Soft delete (is_active = false) keeps analytics data", "file_type": "rationale", "source_file": "README.md", "source_location": "How the locked decisions are enforced", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_csv_import_batching", "label": "CSV import in bounded batches with a temporary-password file", "file_type": "rationale", "source_file": "README.md", "source_location": "How the locked decisions are enforced", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rating_scale_normalisation", "label": "Scale-aware normalisation (axisFor, bounds from rating_scale_options)", "file_type": "rationale", "source_file": "README.md", "source_location": "Rating scales are not interchangeable", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Faculty use a 4-point scale while the others use 5-point, so raw averages are not comparable: bounds come from rating_scale_options per scale rather than a literal 5, since assuming 5 would report a 3.5 faculty average as 63% instead of 83% and make faculty look systematically harsher. Non-scoring options such as 'Not applicable' carry a NULL score and are excluded from averages instead of counting as zero, and axisFor() refuses to return a mixed raw axis at all."}, {"id": "readme_three_denominators", "label": "Three separate denominators: n_answers, n_scored, and their difference", "file_type": "rationale", "source_file": "README.md", "source_location": "Rating scales are not interchangeable", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distributions, averages and non-scoring options each need their own denominator; sharing one is what makes Likert bars appear to sum past 100%."}, {"id": "readme_analytics_admin_ok", "label": "analytics_admin_ok() guard in plpgsql functions", "file_type": "rationale", "source_file": "README.md", "source_location": "Analytics reads are admin-only, and fail loudly", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The analytics functions are SECURITY INVOKER so RLS scopes rows normally, but that alone would show a non-admin aggregates of their own responses with no way to tell, so the guard raises instead. The table-returning functions are plpgsql rather than sql because in a sql body the guard sits inside the row-producing path and the planner skips it once RLS empties that path - handing the non-admin a dashboard of zeros; perform runs before any row work."}, {"id": "readme_execute_grant_hardening", "label": "Revoke execute from PUBLIC, grant back to authenticated", "file_type": "rationale", "source_file": "README.md", "source_location": "Analytics reads are admin-only, and fail loudly", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Revoking execute from anon does nothing on its own because create function grants to PUBLIC and anon inherits through it."}, {"id": "readme_csv_export_identity_exclusion", "label": "CSV export excludes identity answers by question_key", "file_type": "rationale", "source_file": "README.md", "source_location": "The CSV export excludes identity", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dropping user_id does not de-identify an export because name, SAP number and contact details are themselves answers to ordinary form questions; they are excluded by question_key with no opt-in, since a downloaded file has left the app's access controls behind."}, {"id": "readme_csv_formula_escaping", "label": "papaparse escapeFormulae on free text", "file_type": "rationale", "source_file": "README.md", "source_location": "The CSV export excludes identity", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A quoted cell is still an executable formula when an admin opens the file in Excel."}, {"id": "readme_rule_based_sentiment_insights", "label": "Rule-based sentiment and auto-insights layer (src/lib/analytics)", "file_type": "code", "source_file": "README.md", "source_location": "Project layout / Status", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_react_router_7_advisory", "label": "react-router 7 RSC CSRF advisory trade-off", "file_type": "rationale", "source_file": "README.md", "source_location": "Known advisory: react-router 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The unfixed high-severity advisory needs React Server Components mode, which a plain Vite SPA with no server runtime cannot enter, and no patched 7.x exists. Downgrading to v6 would trade it for an XSS-via-open-redirect advisory whose pattern this app does use (return-to-where-you-were after login), so v7 is kept and the redirect is hardened in safeRedirect() instead."}, {"id": "readme_cloudflare_workers_deploy", "label": "Cloudflare Workers deployment (wrangler.jsonc, no main entry)", "file_type": "concept", "source_file": "README.md", "source_location": "Setup step 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VITE_ variables must be build-time because Vite inlines them into the bundle, so runtime vars are too late. Team members deploy free on Cloudflare, whereas Vercel's Hobby tier fails a second contributor's push."}, {"id": "readme_spa_fallback", "label": "SPA fallback: not_found_handling returns index.html", "file_type": "rationale", "source_file": "README.md", "source_location": "Setup step 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cloudflare Pages is closed to new projects so there is no public/_redirects; serving index.html for unmatched paths is what lets a hard refresh on /admin/users reach the router instead of 404ing. No Worker script ever runs - the app is a pure SPA."}, {"id": "readme_first_admin_bootstrap", "label": "Manual first-admin bootstrap SQL", "file_type": "rationale", "source_file": "README.md", "source_location": "Setup step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only admins can register users, so the first admin row must be inserted by hand against auth.users."}, {"id": "readme_temporary_password_distribution", "label": "Temporary password distribution guidance", "file_type": "rationale", "source_file": "README.md", "source_location": "Before onboarding real users", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temporary passwords are shown once, so they must be shared privately and the downloaded credentials file deleted; the database withholds the app role until the password is replaced."}, {"id": "readme_check_suite", "label": "npm run check test suite", "file_type": "code", "source_file": "README.md", "source_location": "Status", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers redirect safety, validation, admin logic, answer remapping across question versions, and the analytics scale/sentiment/insight/CSV rules."}], "edges": [{"source": "readme_curriculum_feedback_platform", "target": "prd_curriculum_feedback_platform", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Requirements live in prd.md", "weight": 1.0}, {"source": "readme_migration_0001_schema", "target": "prd_data_model", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Setup step 3", "weight": 1.0}, {"source": "readme_migration_0002_rls", "target": "prd_rls_security", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "NFR-3", "weight": 1.0}, {"source": "readme_migration_0003_seed", "target": "prd_likert_scales", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "every question from PRD sec 8", "weight": 1.0}, {"source": "readme_migration_0003_seed", "target": "prd_academic_cycles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "first cycle", "weight": 1.0}, {"source": "readme_migration_0004_auth_sync", "target": "readme_profiles_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Setup step 3", "weight": 1.0}, {"source": "readme_profiles_table", "target": "prd_users_table", "relation": "implements", "confidence": "INFERRED", "confi